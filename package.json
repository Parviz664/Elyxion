{
  "name": "elyxion",
  "version": "0.1.0",
  "private": true,
  "description": "Friendly Points prototype and experimental first-contact core for Elyxion",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run build && node dist/src/prototype/server.js",
    "build": "tsc --pretty false",
    "test": "npm run build && node --test dist/tests/unit/*.test.js dist/tests/scenarios/*.test.js",
    "simulate": "npm run build && node dist/src/simulation/run-first-contact.js",
    "experience": "npm run build && node dist/src/presentation/run-first-contact-experience.js",
    "check": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
